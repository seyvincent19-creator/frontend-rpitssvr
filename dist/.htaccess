Options -MultiViews
Options +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Social media bots visiting /article/{id} get served the OG proxy on this same domain
    # so Facebook, Telegram, etc. can read proper og:image / og:title meta tags
    RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|TelegramBot|Slackbot|WhatsApp|Pinterest|ia_archiver) [NC]
    RewriteRule ^article/([0-9]+)/?$ /og-article.php?id=$1 [L,QSA]

    # Serve existing files and directories directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Redirect everything else to index.html
    RewriteRule ^ /index.html [L]
</IfModule>
